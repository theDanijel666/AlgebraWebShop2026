@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Odaberite svoje korisničko ime." disabled />
                <label asp-for="Username" class="form-label"></label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Unesite svoj broj mobitela."/>
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Ime" class="form-control" placeholder="Unesite svoje ime." />
                <label asp-for="Input.Ime" class="form-label"></label>
                <span asp-validation-for="Input.Ime" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Prezime" class="form-control" placeholder="Unesite svoje prezime." />
                <label asp-for="Input.Prezime" class="form-label"></label>
                <span asp-validation-for="Input.Prezime" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Adresa" class="form-control" placeholder="Unesite svoju adresu." />
                <label asp-for="Input.Adresa" class="form-label"></label>
                <span asp-validation-for="Input.Adresa" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Grad" class="form-control" placeholder="Unesite svoj grad." />
                <label asp-for="Input.Grad" class="form-label"></label>
                <span asp-validation-for="Input.Grad" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.PB" class="form-control" placeholder="Unesite svoj poštanski broj." />
                <label asp-for="Input.PB" class="form-label"></label>
                <span asp-validation-for="Input.PB" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Drzava" class="form-control" placeholder="Unesite svoju državu." />
                <label asp-for="Input.Drzava" class="form-label"></label>
                <span asp-validation-for="Input.Drzava" class="text-danger"></span>
            </div>

            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Spremi</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
