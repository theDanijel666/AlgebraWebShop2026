@model IEnumerable<AlgebraWebShop2026.Models.OrderItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Items for order @ViewBag.OrderId</h1>

<p>
    <a asp-action="Create" asp-route-orderid="@ViewBag.OrderId">Add item to order</a>
</p>
<p>
    <a asp-action="Edit" asp-controller="Orders" asp-route-id="@ViewBag.OrderId">Back to order editing</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Item
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MesuringUnit)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Discount)
            </th>
            <th>
                Item total
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ProductTitle)
            </td>
            <td>
                @Html.DisplayFor(model => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price) €
            </td>
            <td>
                @Html.DisplayFor(model => item.MesuringUnit)
            </td>
            <td>
                @Html.DisplayFor(model => item.Discount) %
            </td>
            <td>
                @((item.Quantity*item.Price*(1-item.Discount/100)).ToString("0.00")) €
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    <tr>
        <td></td><td></td><td></td><td></td>
        <td><b>Total price:</b></td>
        <td>@ViewBag.Total.ToString("0.00") €</td>
    </tr>
    </tbody>
</table>
