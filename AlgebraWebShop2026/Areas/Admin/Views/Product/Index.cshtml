@model IEnumerable<AlgebraWebShop2026.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                Main image
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MesuringUnit)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Discount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductCategories)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Images)
            </th> *@
            @* <th>
                @Html.DisplayNameFor(model => model.OrderItems)
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                image
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td>
                @Html.DisplayFor(model => item.MesuringUnit)
            </td>
            <td>
                @Html.DisplayFor(model => item.Discount)
            </td>
            <td>
                @* @Html.DisplayFor(model => item.ProductCategories) *@
                    @if(item.ProductCategories.Count>0){
                        string categories ="";
                        foreach(var category in item.ProductCategories)
                        {
                            categories += category.CategoryTitle + ", ";
                        }

                        categories= categories.Substring(0, categories.Length - 2);

                        @categories
                    }
                    
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Images)
            </td>
            <td>
                @Html.DisplayFor(model => item.OrderItems)
            </td> *@
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a> |
                <a asp-controller="ProductCategory" asp-action="Index" asp-route-productId="@item.Id"> Categories </a> | 
                <a asp-controller="Image" asp-action="Index" asp-route-productId="@item.Id"> Manage images </a>
            </td>
        </tr>
}
    </tbody>
</table>
