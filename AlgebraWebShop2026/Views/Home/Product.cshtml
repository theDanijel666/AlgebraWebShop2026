@model List<Product>

@{
    ViewBag.Title = "Products";
}

<h3>Product list</h3>

<div class="row mb-5">
    <div class="col-2">
        <div class="dropdown">
            <button class="btn btn-secondary" type="button" id="dropdowmMenuButton" data-toggle="dropdown"
                aria-haspopup="true" aria-expanded="false" data-bs-toggle="dropdown"> Filter by category </button>
            <div class="dropdown-menu" aria-labelledby="dropdowmMenuButton">
                @foreach(var item in ViewBag.Categories)
                {
                    <a class="dropdown-item" asp-action="Product" asp-route-categoryId="@item.Id">@item.Title</a> 
                }
            </div>
        </div>
    </div>
    <div class="col-2">
        <a asp-action="Product" class="btn btn-warning"> Reset filters </a>
    </div>
    <div class="col-6"></div>
    <div class="col-2">
        <div class="dropdown">
            <button class="btn btn-secondary" type="button" id="dropdowmMenuButtonSort" data-toggle="dropdown"
                    aria-haspopup="true" aria-expanded="false" data-bs-toggle="dropdown">
                Sort by
            </button>
            <div class="dropdown-menu" aria-labelledby="dropdowmMenuButton">
                <a class="dropdown-item" asp-action="Product" asp-route-sort="Price High to Low"> Price High to Low </a>
                <a class="dropdown-item" asp-action="Product" asp-route-sort="Price Low to High"> Price Low to High </a>
                <a class="dropdown-item" asp-action="Product" asp-route-sort="Name A to Z"> Name A to Z </a>
                <a class="dropdown-item" asp-action="Product" asp-route-sort="Name Z to A"> Name Z to A </a>
            </div>
        </div>
    </div>
</div>
<div class="row mt-3">
    @foreach (var item in Model)
    {
        <div class="col-sm-3">
            <div class="card">
                <div class="card-body">
                    <a asp-action="SingleProduct" asp-route-id="@item.Id" style="text-decoration:none"><h5 class="card-title">@item.Title</h5></a>
                    @{
                        string imgurl = "/Media/No_image.png";
                        if (item.Images.Count > 0)
                        {
                            var img = item.Images.Where(img => img.IsMain).FirstOrDefault();
                            if (img != null) imgurl = img.URL;
                            else
                            {
                                imgurl = item.Images.First().URL;
                            }
                        }
                    }
                    <a asp-action="SingleProduct" asp-route-id="@item.Id" style="text-decoration:none"><img class="card-img" src="@imgurl" /></a>
                    <p class="card-text">
                        @if(item.Description.Length>20) {
                            @: @item.Description.Substring(0,20) ... 
                        }
                        else
                        {
                            @item.Description
                        }
                    </p>
                    <table class="table table-condensed table-hover">
                        <thead>
                            <th>Price</th>
                            <th> </th>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    @item.Price €
                                </td>
                                <td>
                                    @if (item.Quantity > 0)
                                    {
                                        <form method="post" asp-controller="Cart" asp-action="AddToCart">
                                            <input type="hidden" name="productId" value="@item.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <input type="submit" class="btn btn-success btn-sm" value="Add to c cart" />
                                        </form>
                                    }
                                    else
                                    {
                                        <label class="btn btn-danger">Out of stock!</label>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    }

    @if(Model.Count==0) {
        <p> No products to display! </p>
    }

</div>