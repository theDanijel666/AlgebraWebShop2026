@using AlgebraWebShop2026.Extensions;
@model List<CartItem>
@{
    ViewData["Title"] = "Order";
}

<div class="text-center mb-3">
    <h1 class="display-4"> Place your order</h1>
</div>

<hr />

<div class="container">
    <div class="row mt-3">
        <div class="col">

@if (Model.Count == 0)
{
    <div class="text-center">
        <h4 class="display-4"> Your cart is empty! </h4>
        <hr>
        <a asp-controller="Home" asp-action="Product"> Continue shopping :)</a>
    </div>
}
else
{
    <div class="text-center">
        <h5> Cart items </h5>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>Product</th>
                <th></th>
                <th>Price</th>
                <th>Discount</th>
                <th>Unit of mesurment</th>
                <th>Quantity</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <a class="btn btn-sm btn-danger" asp-controller="Cart" asp-action="RemoveFromCart"
                           asp-route-productId="@item.Product.Id">Remove</a>
                    </td>
                    <td>
                        <a asp-controller="Home" asp-action="SingleProduct"
                           asp-route-id="@item.Product.Id" style="text-decoration:none"> @item.Product.Title </a>
                    </td>
                    <td>
                        @{
                            string imgurl = "/Media/No_image.png";
                            if (item.Product.Images.Count > 0)
                            {
                                var img = item.Product.Images.Where(img => img.IsMain).FirstOrDefault();
                                if (img != null) imgurl = img.URL;
                                else
                                {
                                    imgurl = item.Product.Images.First().URL;
                                }
                            }
                        }
                        <a asp-controller="Home" asp-action="SingleProduct"
                           asp-route-id="@item.Product.Id" style="text-decoration:none">
                            <img src="@imgurl" width="80" />
                        </a>
                    </td>
                    <td>
                        @item.Product.Price.ToString("0.00") €
                    </td>
                    <td>
                        @item.Product.Discount.ToString("0.00") %
                    </td>
                    <td>
                        @item.Product.MesuringUnit
                    </td>
                    <td>
                        <form method="post" asp-action="UpdateQuantity" asp-controller="Cart">
                            <input type="hidden" name="productId" value="@item.Product.Id" />
                            <input type="number" name="quantity" title="quantity" value="@item.Quantity.ToString("0")" />
                            <input type="submit" class="btn btn-success btn-sm" value="Update" />
                        </form>
                    </td>
                    <td>
                        @item.getTotal().ToString("0.00") €
                    </td>
                </tr>
            }
            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td><b>Total price:</b></td>
                <td><b>@ViewBag.TotalPrice.ToString("0.00") €</b></td>
            </tr>
        </tbody>
    </table>
            }

        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col">
        @if (ViewBag.Errors.Count > 0)
        {
            <div class="alert alert-danger text-center" role="alert">
                @foreach(var error in ViewBag.Errors)
                {
                    <p>@error</p>
                }
            </div>
        }
    </div>
</div>

<div class="row mt-3">
    <div class="col">
        <hr />
        <div class="text-center">
            <h4> Personal information</h4>
        </div>
        <hr />
        <form method="post" asp-controller="Order" asp-action="CreateOrder">
            <input type="hidden" name="Total" value="@ViewBag.TotalPrice" />
            <div class="text-center">
                <h5>Billing information</h5>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <label for="BillingFirstName"> First name *</label>
                    <input type="text" class="form-control" id="BillingFirstName" name="BillingFirstName" />
                </div>
                <div class="col-md-6">
                    <label for="BillingLastName"> Last name *</label>
                    <input type="text" class="form-control" id="BillingLastName" name="BillingLastName" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <label for="BillingEmail"> E-mail *</label>
                    <input type="text" class="form-control" id="BillingEmail" name="BillingEmail" />
                </div>
                <div class="col-md-6">
                    <label for="BillingPhone"> Phone *</label>
                    <input type="text" class="form-control" id="BillingPhone" name="BillingPhone" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <label for="BillingAddress"> Address *</label>
                    <input type="text" class="form-control" id="BillingAddress" name="BillingAddress" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <label for="BillingCity"> City *</label>
                    <input type="text" class="form-control" id="BillingCity" name="BillingCity" />
                </div>
                <div class="col-md-4">
                    <label for="BillingCountry"> Country * </label>
                    <select class="form-control" id="BillingCountry" name="BillingCountry">
                        <option>Croatia</option>
                        <option>Slovenia</option>
                        <option>Serbia</option>
                        <option>Bosnia and Hercegovina</option>
                        <option>Monte Negro</option>
                        <option>Hungary</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="BillingZIP"> ZIP *</label>
                    <input type="text" class="form-control" id="BillingZIP" name="BillingZIP" />
                </div>
            </div>
            <br />
            <div class="text-center">
                <h5>Shipping information</h5>
            </div>
            <div class="row align-items-center">
                <div class="col-auto d-flex align-items-center">
                    <input type="checkbox" class="forms-check-input me-2" onchange="toggleshippinginfo()"
                           id="ShippingSameAsBilling" name="ShippingSameAsBilling" />
                    <label for="ShippingSameAsBilling" class="form-check-label mb-0"> Shipping same as billing </label>
                </div>
            </div>
            <div id="shippinginfo">
                <div class="row">
                    <div class="col-md-6">
                        <label for="ShippingFirstName"> First name *</label>
                        <input type="text" class="form-control" id="ShippingFirstName" name="ShippingFirstName" />
                    </div>
                    <div class="col-md-6">
                        <label for="ShippingLastName"> Last name *</label>
                        <input type="text" class="form-control" id="ShippingLastName" name="ShippingLastName" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <label for="ShippingEmail"> E-mail *</label>
                        <input type="text" class="form-control" id="ShippingEmail" name="ShippingEmail" />
                    </div>
                    <div class="col-md-6">
                        <label for="ShippingPhone"> Phone *</label>
                        <input type="text" class="form-control" id="ShippingPhone" name="ShippingPhone" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <label for="ShippingAddress"> Address *</label>
                        <input type="text" class="form-control" id="ShippingAddress" name="ShippingAddress" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <label for="ShippingCity"> City *</label>
                        <input type="text" class="form-control" id="ShippingCity" name="ShippingCity" />
                    </div>
                    <div class="col-md-4">
                        <label for="ShippingCountry"> Country * </label>
                        <select class="form-control" id="ShippingCountry" name="ShippingCountry">
                            <option>Croatia</option>
                            <option>Slovenia</option>
                            <option>Serbia</option>
                            <option>Bosnia and Hercegovina</option>
                            <option>Monte Negro</option>
                            <option>Hungary</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="ShippingZIP"> ZIP *</label>
                        <input type="text" class="form-control" id="ShippingZIP" name="ShippingZIP" />
                    </div>
                </div>
            </div>
            <script>
                            function toggleshippinginfo(){
                                var vis=document.getElementById("shippinginfo").style.display;
                                if(vis=="none") document.getElementById("shippinginfo").style.display="";
                                else document.getElementById("shippinginfo").style.display="none";
                            }
            </script>
        </form>
    </div>
</div>